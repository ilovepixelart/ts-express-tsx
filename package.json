{
  "name": "ts-express-tsx",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./dist/bin/www.js",
    "build": "tsc",
    "dev": "tsx watch src/bin/www.ts",
    "biome": "npx @biomejs/biome check",
    "biome:fix": "npx @biomejs/biome check --write .",
    "test": "vitest run --coverage",
    "test:open": "npm test && open-cli coverage/lcov-report/index.html"
  },
  "dependencies": {
    "@biomejs/biome": "2.4.16",
    "cookie-parser": "1.4.7",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "http-errors": "2.0.1",
    "mongoose": "9.6.3",
    "morgan": "1.11.0",
    "pug": "3.0.4",
    "ts-cache-mongoose": "2.2.1",
    "ts-migrate-mongoose": "5.3.3",
    "ts-patch-mongoose": "4.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/debug": "4.1.13",
    "@types/express": "5.0.6",
    "@types/http-errors": "2.0.5",
    "@types/morgan": "1.9.10",
    "@types/node": "25.9.2",
    "@vitest/coverage-v8": "4.1.8",
    "mongodb-memory-server": "11.2.0",
    "open-cli": "9.0.0",
    "tsx": "4.22.4",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "file-type": "21.3.2"
  }
}
